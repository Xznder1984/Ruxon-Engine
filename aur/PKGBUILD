# Maintainer: Ruxon Engine Contributors
pkgname=ruxon-engine
pkgver=0.0.1
pkgrel=1
pkgdesc="Free, open source game engine for 2D and 3D games"
arch=('x86_64')
url="https://github.com/Xznder1984/Ruxon-Engine"
license=('MIT')
depends=('sdl3')
makedepends=('cmake' 'ninja' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/Ruxon-Engine-$pkgver"
  cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$srcdir/Ruxon-Engine-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
